<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="[Luna] %d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
        <!-- Luna Agent 运行日志（启动、HTTP 请求等） -->
        <RollingFile name="File" fileName="luna-agent.log" filePattern="luna-agent.%d{yyyy-MM-dd}.log">
            <PatternLayout pattern="[Luna] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>
        <!-- 注入探针日志（独立文件，便于长期监控与偶发问题排查） -->
        <RollingFile name="ProbeFile" fileName="luna-probe.log" filePattern="luna-probe.%d{yyyy-MM-dd}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="50 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <!-- 探针日志独立 logger，additivity=false 避免重复写入 luna-agent.log -->
        <Logger name="luna.probe" level="INFO" additivity="false">
            <AppenderRef ref="ProbeFile"/>
        </Logger>
        <Logger name="fun.efto.luna" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Logger>
        <Root level="INFO">
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
